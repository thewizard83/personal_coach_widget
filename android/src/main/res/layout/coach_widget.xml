<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/coach_radice"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/coach_sfondo"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/coach_settimana"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="Settimana 1/22"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/coach_streak"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔥 0"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/coach_fase"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="Fase 1 · Base"
        android:textColor="#E6FFFFFF"
        android:textSize="12sp" />

    <ProgressBar
        android:id="@+id/coach_barra"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="6dp"
        android:max="100"
        android:progress="5"
        android:progressDrawable="@drawable/coach_progresso" />

    <TextView
        android:id="@+id/coach_statistiche"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="✓ 0 fatte · ✕ 0 saltate · 0% del piano"
        android:textColor="#E6FFFFFF"
        android:textSize="11sp" />

    <LinearLayout
        android:id="@+id/coach_card"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:background="@drawable/coach_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="10dp">

        <ImageView
            android:id="@+id/coach_icona"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:contentDescription="Tipo di seduta"
            android:src="@drawable/coach_tipo_corsa" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/coach_etichetta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="PROSSIMA · CORSA"
                android:textColor="#2EAD6B"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/coach_titolo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="Apri l'app per caricare il piano"
                android:textColor="#0F172A"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/coach_quando"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:text=""
                android:textColor="#475569"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/coach_riassunto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:ellipsize="end"
                android:text=""
                android:textColor="#64748B"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/coach_nota"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:background="@drawable/coach_chip"
                android:maxLines="2"
                android:ellipsize="end"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:text=""
                android:textColor="#1F6FEB"
                android:textSize="10sp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
